# ===== DashScope / 阿里云百炼（OpenAI-compatible API）=====
# 填写真实 API Key，不要带引号，例如：DASHSCOPE_API_KEY=sk-xxxxxxxx
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
SUPPORTOPS_MODEL=qwen-plus
DASHSCOPE_EMBEDDING_MODEL=text-embedding-v3

# ===== 存储 =====
# Docker Compose 默认值：
DATABASE_URL=postgresql://postgres:pg123456@supportops_pg:5432/gsk
ES_HOST=http://supportops_es:9200
# 本机直跑（不经 compose）时可改为：
# DATABASE_URL=postgresql://postgres:pg123456@localhost:5432/gsk
# ES_HOST=http://localhost:9200

POSTGRES_PASSWORD=pg123456
POSTGRES_DB=gsk
ELASTIC_PASSWORD=supportops_es_password
ES_MEM_LIMIT=2g

# ===== 应用 =====
JWT_SECRET_KEY=supportops_local_secret
# LangGraph PostgreSQL checkpoint 连接池大小
SUPPORTOPS_CHECKPOINT_POOL_SIZE=8
# 逗号分隔的 CORS 允许来源；本地默认放开
CORS_ORIGINS=*
TIMEZONE=Asia/Shanghai
